<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="com.utez.objetosperdidos.controller.EntregarObjetoController"
            prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15" style="-fx-padding: 10;">
            <Button text="Home" prefHeight="40" prefWidth="60" />
            <Label text="Objetos Perdidos">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Administrador"/>
            <ImageView fitHeight="40" fitWidth="40" pickOnBounds="true" preserveRatio="true"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="30" alignment="CENTER" style="-fx-padding: 20;">
            <!-- Vista previa -->
            <VBox spacing="15" alignment="TOP_CENTER">
                <Label text="Vista previa"/>
                <ImageView fx:id="imgPreview" fitHeight="250.0" fitWidth="220.0"
                           style="-fx-border-color: #aaa; -fx-border-width: 1; -fx-background-color: white;
                                  -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0.5, 0, 2);"
                           preserveRatio="true"/>
                <Button fx:id="btnSubirImagen" text="Subir imagen" onAction="#handleSubirImagen"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
            </VBox>

            <!-- Formulario -->
            <VBox spacing="15" prefWidth="600">
                <Label text="Agregar Objeto">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Título:">
                        <font><Font name="System" size="14.0"/></font>
                    </Label>
                    <Label fx:id="lblTitulo" prefWidth="400"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Marca:">
                        <font><Font name="System" size="14.0"/></font>
                    </Label>
                    <Label fx:id="lblMarca" prefWidth="400"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Modelo:">
                        <font><Font name="System" size="14.0"/></font>
                    </Label>
                    <Label fx:id="lblModelo" prefWidth="400"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="No. Serial:">
                        <font><Font name="System" size="14.0"/></font>
                    </Label>
                    <Label fx:id="lblNoSerie" prefWidth="400"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Archivo imagen:"/>
                    <TextField fx:id="fotoUrlField" editable="false" prefWidth="400"
                               style="-fx-background-radius: 5; -fx-border-radius: 5;
                                      -fx-border-color: #ccc; -fx-border-width: 1;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Descripción:">
                        <font><Font name="System" size="14.0"/></font>
                    </Label>
                    <Label fx:id="lblDescripcion" wrapText="true" prefWidth="400" />
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Alumno:">
                        <font><Font name="System" size="14.0"/></font>
                    </Label>
                    <TextField fx:id="txtAlumno" prefWidth="400"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Matrícula:">
                        <font><Font name="System" size="14.0"/></font>
                    </Label>
                    <TextField fx:id="txtMatricula" prefWidth="400"/>
                </HBox>

                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button text="Cancelar" onAction="#cancelar"/>
                    <Button text="Guardar" onAction="#confirmarEntrega"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
