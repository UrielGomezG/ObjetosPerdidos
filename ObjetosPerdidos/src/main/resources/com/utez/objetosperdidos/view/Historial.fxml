<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/Historial.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.utez.objetosperdidos.controller.HistorialObjetoController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="900.0" BorderPane.alignment="CENTER">
            <children>
                <Region prefHeight="60.0" prefWidth="10.0" />
                <Button mnemonicParsing="false" prefWidth="0.0">
                    <graphic>
                        <FontIcon iconLiteral="fa-home" iconSize="40" />
                    </graphic>
                </Button>
                <Region prefHeight="60.0" prefWidth="19.0" />
                <Label text="Objetos perdidos" />
                <Region prefHeight="60.0" prefWidth="591.0" />
                <Label fx:id="userNameLabel" prefWidth="100.0" />
                <Region prefHeight="60.0" prefWidth="11.0" />
                <ImageView fitHeight="46.0" fitWidth="57.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </HBox>
    </top>

    <left>
      <VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="60.0" BorderPane.alignment="CENTER">
         <children>
            <Region prefHeight="20.0" prefWidth="200.0" />
            <Button mnemonicParsing="false">
               <graphic>
                  <FontIcon iconLiteral="fa-plus-circle" iconSize="40" />
               </graphic></Button>
            <Region prefHeight="20.0" prefWidth="200.0" />
            <Button mnemonicParsing="false">
               <graphic>
                  <FontIcon iconLiteral="fa-history" iconSize="40" />
               </graphic></Button>
            <Region prefHeight="367.0" prefWidth="60.0" VBox.vgrow="ALWAYS" />
            <Button mnemonicParsing="false">
               <graphic>
                  <FontIcon iconLiteral="fa-sign-out" iconSize="40" />
               </graphic></Button>
            <Region prefHeight="10.0" prefWidth="200.0" />
         </children>
      </VBox>
   </left>

    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <FlowPane fx:id="itemsContainer" hgap="10" prefHeight="400" vgap="10" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>


</BorderPane>
