<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="mainContainer" prefHeight="700" prefWidth="1000" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.utez.objetosperdidos.controller.HomeController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f8f8f8;" BorderPane.alignment="CENTER">
            <HBox.margin>
                <Insets bottom="10" left="10" right="10" top="10" />
            </HBox.margin>
         <Region prefHeight="40.0" prefWidth="4.0" />
            <Button prefHeight="36.0" prefWidth="37.0" style="-fx-font-size: 16px;" text="🏠" />
         <Region prefHeight="40.0" prefWidth="8.0" />
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Objetos Perdidos" />
         <Region prefHeight="40.0" prefWidth="129.0" />
         <StackPane prefHeight="40.0" prefWidth="380.0">
            <children>
                  <TextField prefHeight="25.0" prefWidth="232.0" promptText="Buscar..." />
                  <Button text="🔍" StackPane.alignment="CENTER_RIGHT" />
            </children>
         </StackPane>
         <Region prefHeight="40.0" prefWidth="32.0" />
            <Label fx:id="userNameLabel" style="-fx-padding: 0 10 0 10;" text="Nombre de Usuario" />
            <ImageView fitHeight="40" fitWidth="40" preserveRatio="true" />
        </HBox>
    </top>

    <left>
        <VBox prefHeight="615.0" prefWidth="69.0" spacing="20" style="-fx-padding: 10; -fx-background-color: #eaeaea;">
            <Button style="-fx-font-size: 20px;" text="☰" />
            <Button prefHeight="43.0" prefWidth="47.0" onAction="#onPerfil" style="-fx-font-size: 20px;" text="👤" />
        </VBox>
    </left>


    <center>
        <TilePane fx:id="objectGrid" hgap="20" prefColumns="3" vgap="20">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ImageView fitHeight="200.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="OBJETO">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Text>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Marca:" />
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Modelo:" />
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Número de serie:" />
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Descripción:" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
        </TilePane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
            <Button text="≪" />
            <Button text="&lt;" />
            <Button style="-fx-font-weight: bold;" text="1" />
            <Button text="2" />
            <Button text="3" />
            <Button text="&gt;" />
            <Button text="≫" />
        </HBox>
    </bottom>

</BorderPane>
