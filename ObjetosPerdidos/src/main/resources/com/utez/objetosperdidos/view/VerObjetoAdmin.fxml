<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="background" stylesheets="@../css/VerObjetoAdmin.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.utez.objetosperdidos.controller.VerObjetoAdmin">

    <center>
        <HBox alignment="CENTER" spacing="30" style="-fx-padding: 20;">

            <!-- Vista previa -->
            <VBox alignment="TOP_CENTER" spacing="15">
                <HBox prefHeight="43.0" prefWidth="220.0">
                    <Label styleClass="titulo" text="Ver objeto" />
                </HBox>
                <Label text="Vista previa">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <ImageView fx:id="imgPreview" fitHeight="316.0" fitWidth="220.0" preserveRatio="true"
                           style="-fx-border-color: #aaa; -fx-border-width: 1; -fx-background-color: white;
                                  -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0.5, 0, 2);" />
                <Label text="Credencial del Alumno">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <ImageView fx:id="imgCredencial" fitHeight="150.0" fitWidth="220.0" preserveRatio="true"
                           style="-fx-border-color: #aaa; -fx-border-width: 1; -fx-background-color: white;
                                  -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0.5, 0, 2);" />
            </VBox>

            <!-- Formulario -->
            <VBox prefWidth="600" spacing="15">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="Título:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="35.0" prefWidth="32.0" />
                    <Label fx:id="lblTitulo" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="Marca:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="35.0" prefWidth="31.0" />
                    <Label fx:id="lblMarca" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="Modelo:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="35.0" prefWidth="19.0" />
                    <Label fx:id="lblModelo" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="No. Serial:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="35.0" prefWidth="3.0" />
                    <Label fx:id="lblNoSerie" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="Aula:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="35.0" prefWidth="47.0" />
                    <Label fx:id="lblAula" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="Edificio:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="35.0" prefWidth="23.0" />
                    <Label fx:id="lblEdificio" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox prefHeight="134.0" prefWidth="600.0" spacing="10">
                    <Label styleClass="textStyle" text="Descripción:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Label fx:id="lblDescripcion" prefHeight="136.0" prefWidth="415.0" styleClass="textField" wrapText="true">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="Alumno:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="35.0" prefWidth="25.0" />
                    <Label fx:id="lblAlumno" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="Matrícula:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="35.0" prefWidth="9.0" />
                    <Label fx:id="lblMatricula" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="textStyle" text="Fecha:">
                        <font><Font name="System" size="14.0" /></font>
                    </Label>
                    <Region prefHeight="33.0" prefWidth="40.0" />
                    <Label fx:id="lblFechaEntrega" prefHeight="35.0" prefWidth="415.0" styleClass="textField">
                        <padding><Insets left="5.0" /></padding>
                    </Label>
                </HBox>

            </VBox>
        </HBox>
    </center>
</BorderPane>
