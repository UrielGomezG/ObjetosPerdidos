<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.ComboBox?>

<VBox prefHeight="600" prefWidth="900" spacing="10"
      stylesheets="@../css/objeto.css"
      style="-fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.utez.objetosperdidos.controller.ObjetosController">

    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10;">
        <Label text="Buscar por nombre:" />
        <StackPane alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="370.0">
            <children>
                <TextField fx:id="txtBuscar" promptText="Ej. mochila, celular..." />
                <Button fx:id="btnBuscar">
                    <graphic>
                        <FontIcon iconLiteral="fa-search" />
                    </graphic>
                </Button>
            </children>
        </StackPane>
        <Region prefHeight="50.0" prefWidth="107.0" HBox.hgrow="ALWAYS" />
        <Label text="Filtrar por categoría:" />
        <ComboBox fx:id="cbCategoria" promptText="Categoría" />
    </HBox>

    <ScrollPane fitToWidth="true">
        <content>
            <FlowPane fx:id="contenedorTarjetas"
                      alignment="CENTER"
                      hgap="15"
                      vgap="15"
                      prefWrapLength="880"
                      style="-fx-padding: 20;" />
        </content>
    </ScrollPane>
</VBox>
